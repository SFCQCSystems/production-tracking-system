# =========================================================================
# MES CONFIGURATION & DATABASE PROVIDER
# =========================================================================

# Database mode: 'local' (ใช้ฐานข้อมูลในเครื่อง) หรือ 'supabase' (เมื่อพร้อมขึ้นคลาวด์)
VITE_DATABASE_MODE=local

# การตั้งค่าสำหรับเชื่อมต่อ Supabase ในอนาคต (เว้นว่างไว้ก่อนได้)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local Backend Port (Default 3001)
PORT=3001

# =========================================================================
# DYNAMIC API INTEGRATION — Encryption Key for API Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =========================================================================
API_CONFIG_ENCRYPTION_KEY=
